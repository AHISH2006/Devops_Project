pipeline {
    agent any

    environment {
        IMAGE_NAME = 'akashessencecore/physio-app'
        DOCKER_REGISTRY = 'docker.io'
        GIT_REPO_URL = 'https://github.com/AHISH2006/Devops_Project.git'
    }

    stages {
        stage('Clone Repository') {
            steps {
                git branch: 'main',
                    credentialsId: 'github-credentials',
                    url: "${GIT_REPO_URL}"
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    docker.build("${IMAGE_NAME}:latest")
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry("https://${DOCKER_REGISTRY}", 'dockerhub-credentials') {
                        docker.image("${IMAGE_NAME}:latest").push()
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                script {
                    echo "Deploying ${IMAGE_NAME}:latest to production..."
                    sh """
                        docker pull ${IMAGE_NAME}:latest
                        docker stop physio-app || true
                        docker rm physio-app || true
                        docker run -d --name physio-app -p 80:80 ${IMAGE_NAME}:latest
                    """
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completed successfully!'
        }
        failure {
            echo '❌ Pipeline failed. Check logs above.'
        }
    }
}
